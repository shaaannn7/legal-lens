# Legal Lens — Environment Configuration
# Copy this file to .env.local and update values as needed.

# Path where documents and analysis JSON files are stored on the server.
# Default: ./data (relative to project root)
DATA_DIR=./data

# Application URL — used in Open Graph meta tags for social sharing previews.
# Update to your deployment URL in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Node environment (do not change unless you know what you're doing)
NODE_ENV=development
